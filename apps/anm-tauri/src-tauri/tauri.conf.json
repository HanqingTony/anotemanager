{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anm-tauri",
  "version": "0.1.0",
  "identifier": "com.anm.tray",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "anm",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "additionalBrowserArgs": "--force-device-scale-factor=1 --remote-debugging-port=9222 --remote-allow-origins=*"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/anm.ico"]
  }
}
