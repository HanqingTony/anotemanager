{
  "applicationId": "com.anm.tray",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "exportAuthInfo": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "window.*",
    "os.*",
    "debug.*",
    "computer.*",
    "events.*",
    "extensions.*",
    "storage.*",
    "resources.*",
    "clipboard.*",
    "filesystem.*"
  ],
  "modes": {
    "window": {
      "title": "anm-tray",
      "width": 1920,
      "height": 1080,
      "center": true,
      "transparent": true,
      "borderless": true,
      "alwaysOnTop": true,
      "icon": "/resources/icons/appIcon.png"
    }
  },
  "extensions": [
    {
      "id": "anmNative",
      "commandWindows": "${NL_PATH}\\extensions\\anm-native-ext.exe"
    }
  ]
}